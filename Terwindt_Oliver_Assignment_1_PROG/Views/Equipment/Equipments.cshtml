@using Terwindt_Oliver_Assignment_1_PROG.Models
@model IEnumerable<Equipment>

<h1>@ViewData["Title"]</h1>

<table class="table">
    <tr>
        <th>Id</th>
        <th>Type</th>
        <th>Description</th>
        <th>Available</th>
    </tr>
    @foreach (var equipment in Model)
    {
        <tr class="@(equipment.IsAvailable ? "table-success" : "table-danger")">
            <td>@equipment.Id</td>
            <td>@equipment.Type</td>
            <td>@equipment.Description</td>
            <td>@equipment.IsAvailable</td>
        </tr>
    }
</table>
